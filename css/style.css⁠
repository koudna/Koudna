        .course-lesson-card.done .course-lesson-number { background:rgba(16,185,129,.15)!important; color:#5ee0b0!important; }
        .course-lesson-card.locked { background:#09131c; }

        @media (max-width: 1000px) { .courses-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
        @media (max-width: 600px) {
            .courses-grid { grid-template-columns:1fr; }
            .hero { min-height:auto; padding:68px 0 60px; }
            .courses-toolbar { padding:10px; }
            .course-card { min-height:0; }
        }

    
