        .course-progress-track { height:8px; border-radius:99px; overflow:hidden; background:var(--border); }
        .course-progress-track span { display:block; height:100%; border-radius:inherit; background:linear-gradient(90deg,var(--primary),var(--secondary)); width:0; transition:width .35s ease; }
        .course-lessons-head { display:flex; align-items:end; justify-content:space-between; gap:15px; margin:28px 0 14px; }
