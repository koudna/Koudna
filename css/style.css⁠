.course-continue-btn { display:inline-flex; align-items:center; justify-content:center; gap:9px; min-height:44px; padding:11px 16px; border:1px solid rgba(24,216,207,.25); border-radius:14px; background:linear-gradient(135deg,rgba(24,216,207,.16),rgba(22,135,255,.13)); color:#eafcff; font-family:var(--heading); font-weight:900; cursor:pointer; transition:var(--transition); box-shadow:0 10px 30px rgba(24,216,207,.08); }
